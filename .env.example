# Copy to .env and fill in only what you actually want to change —
# every one of these has a working default (see README "Environment
# variables"), so an empty .env is a valid starting point.

# Optional: enables real-time carbon figures via Climatiq instead of the
# local emission-factor table. Get a free key at https://www.climatiq.io
# (2,500 calls/month free tier, no credit card). Leave blank to use the
# local table — that is a fully documented fallback, not a degraded mode.
CLIMATIQ_API_KEY=

# Only relevant for local, non-Docker development if you want the action
# server / Rasa server / flight service on non-default ports or hosts.
# RASA_URL=http://localhost:5005
# ACTIONS_HOST=localhost
# FLIGHT_SERVICE_URL=http://localhost:8000
